# Environment variables
#
# The app works with NONE of these set: it runs fully in local-only mode, storing
# workouts and history in the browser. Each block below unlocks one capability.


# ---------------------------------------------------------------------------
# Database (workout history + cross-device sync)
# ---------------------------------------------------------------------------
# On Railway, reference the Postgres plugin instead of pasting a connection string:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Without this the app stays local-only and /api/* answers 503.
DATABASE_URL="postgresql://user:password@host:5432/dbname"


# ---------------------------------------------------------------------------
# Accounts / sign-in (REQUIRED for phone <-> computer sync)
# ---------------------------------------------------------------------------
# Cross-device sync is per-user, so it needs an account. Accounts are enabled only
# when ALL THREE hold:
#   1. DATABASE_URL is set (above)
#   2. at least one OAuth provider below is configured
#   3. NEXTAUTH_URL and NEXTAUTH_SECRET are both set
# If 1 and 2 hold but 3 does not, /api/auth answers 503 naming what is missing.

# Your public app URL (no trailing slash), e.g. https://boxing-rounds-timer.up.railway.app
NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- Pick at least ONE provider ---

# GitHub: https://github.com/settings/developers -> New OAuth App
#   Homepage URL:              <NEXTAUTH_URL>
#   Authorization callback URL: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""

# Google: https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web)
#   Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
