generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// next-auth models (optional accounts).
//
// The app runs anonymously by default: with no DATABASE_URL it stays in
// Local_Only_Mode and never touches these tables (requirement 12.10). They exist
// so a user who signs in gets their workouts and history on every device.
// ---------------------------------------------------------------------------

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String?          @unique
  emailVerified   DateTime?
  image           String?
  accounts        Account[]
  sessions        Session[]
  workouts        Workout[]
  workoutSessions WorkoutSession[]
  createdAt       DateTime         @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain models
// ---------------------------------------------------------------------------

enum WorkoutType {
  BOXING
  MMA
  CUSTOM
}

/// A reusable workout definition — the server-side evolution of the localStorage Preset.
/// `id` is the client-generated identifier, which is what makes the API upsert idempotent
/// (requirement 8.5).
model Workout {
  id           String      @id @default(cuid())
  /// null => a record synced without an account.
  userId       String?
  name         String
  type         WorkoutType @default(BOXING)
  rounds       Int
  roundSeconds Int
  restSeconds  Int
  prepSeconds  Int         @default(5)
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user     User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions WorkoutSession[]

  @@index([userId])
}

/// A completed (or stopped) run of a workout — the history record.
///
/// `workoutName` and `type` are denormalized snapshots so history keeps reading correctly
/// after the workout definition it came from is deleted (requirements 6.4, 6.6).
model WorkoutSession {
  id              String      @id @default(cuid())
  userId          String?
  /// Nullable: the workout definition may be deleted later.
  workoutId       String?
  /// Denormalized snapshot of the workout name at the time of the run.
  workoutName     String
  /// Denormalized snapshot of the workout type at the time of the run.
  type            WorkoutType
  roundsPlanned   Int
  roundsCompleted Int
  /// Effective elapsed time in milliseconds; excludes time spent paused.
  totalDurationMs Int
  /// true when the run reached phase `finished`.
  completed       Boolean     @default(false)
  startedAt       DateTime
  endedAt         DateTime    @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)

  @@index([userId, endedAt])
}
